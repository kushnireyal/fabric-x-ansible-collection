    {
      "id": 2,
      "type": "timeseries",
      "title": "SendTransaction rate (per outcome)",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(evm_loadgen_sendtx_total[30s]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "description": "Rate of `gateway.SendTransaction` calls, split by outcome label: `enqueued` (passed ValidateTx and inserted into the gateway TxQueue) vs `validation_error` (rejected by ValidateTx \u2014 invalid signature, bad chain ID, etc.). Source: gateway/core/api.go:190 + :195. 30s rolling rate. This is SUBMISSION rate at the loadgen entry \u2014 NOT commit rate."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Committed rate (per result)",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(evm_loadgen_committed_total[30s]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "description": "Rate of commit notifications received by the test via `TxCompletionTracker.HandleTx`, split by `success` (committer status=COMMITTED) vs `failed` (any other status). 30s rolling rate. This is the actual END-TO-END throughput \u2014 what the committer has finalized. Works in both closed-loop and open-loop."
    },
